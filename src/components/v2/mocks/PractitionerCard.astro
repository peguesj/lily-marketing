---
import LilyVerifiedBadge from './LilyVerifiedBadge.astro';

/** Fictional practitioner / candidate card. Variants: supervisor | candidate | compact. */
interface Props {
  variant?: 'supervisor' | 'candidate' | 'compact';
  name?: string;
  initials?: string;
  meta?: string;
  chips?: string[];
}
const { variant = 'supervisor' } = Astro.props;
const defaults = {
  supervisor: {
    name: 'Elena Reyes, LCSW',
    initials: 'ER',
    meta: 'Philadelphia, PA · Licensed 2012 · 14 years',
    chips: ['Evenings', 'Virtual', 'Group of four', 'Trauma-informed'],
  },
  candidate: {
    name: 'Maya Okafor, MSW',
    initials: 'MO',
    meta: 'Pursuing LCSW · Montgomery County, PA',
    chips: ['Evenings', 'Individual', 'Gender identity', 'Language'],
  },
  compact: {
    name: 'Elena Reyes, LCSW',
    initials: 'ER',
    meta: 'Philadelphia, PA · 14 years',
    chips: [] as string[],
  },
}[variant];
const name = Astro.props.name ?? defaults.name;
const initials = Astro.props.initials ?? defaults.initials;
const meta = Astro.props.meta ?? defaults.meta;
const chips = Astro.props.chips ?? defaults.chips;
---

<article class:list={['card', variant]} data-mock="PractitionerCard" data-variant={variant} data-illustrative>
  <header class="head">
    <span class="avatar" aria-hidden="true">{initials}</span>
    <div class="who">
      <h3>{name} <span class="example">Example</span></h3>
      <p class="meta">{meta}</p>
    </div>
  </header>

  {variant === 'supervisor' && (
    <>
      <div class="badge"><LilyVerifiedBadge /></div>
      <dl class="cols">
        <div>
          <dt>LICENSE</dt>
          <dd>PA CW012345 · active (example)</dd>
          <dd class="sub">Checked against the proposed license-review source on Oct 3, 2026</dd>
        </div>
        <div>
          <dt>RATES</dt>
          <dd>$120 /hr individual</dd>
          <dd>$45 /hr group</dd>
        </div>
      </dl>
    </>
  )}

  {variant === 'candidate' && (
    <div class="hours">
      <div class="hours-row"><span>Hours counted</span><strong>1,240 of 3,000</strong></div>
      <div class="bar" role="progressbar" aria-label="Hours counted" aria-valuemin="0" aria-valuemax="3000" aria-valuenow="1240"><span style="width:41%"></span></div>
      <p class="sub">Seeking: LCSW supervision · up to $110 /hr</p>
    </div>
  )}

  {variant === 'compact' && <div class="badge"><LilyVerifiedBadge /></div>}

  {chips.length > 0 && (
    <ul class="chips" aria-label="Tags">
      {chips.map((c) => <li>{c}</li>)}
    </ul>
  )}

  {variant === 'supervisor' && (
    <p class="privacy">Contact details stay private until you both accept a match.</p>
  )}
  {variant !== 'supervisor' && variant !== 'compact' && (
    <p class="tag" data-illustrative>Illustrative · pending validation</p>
  )}
</article>

<style>
  .card {
    box-sizing: border-box;
    width: 100%;
    max-width: 400px;
    padding: 20px;
    background: var(--lily-surface, #f8f5ef);
    border: 1px solid var(--lily-border, #d5dfd9);
    border-radius: var(--radius-card, 1.25rem);
    box-shadow: var(--shadow-card, 0 4px 8px rgb(20 82 46 / 8%));
    color: var(--lily-text, #14522e);
    font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif);
  }
  .compact { padding: 12px 14px; max-width: 320px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .head { display: flex; gap: 12px; align-items: center; }
  .avatar {
    display: grid; place-items: center; flex: none;
    width: 46px; height: 46px; border-radius: 50%;
    background: rgb(20 82 46 / 10%); font-weight: 600; font-size: 15px;
  }
  .compact .avatar { width: 34px; height: 34px; font-size: 12px; }
  h3 { margin: 0; font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .example {
    font-size: 9.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 2px 7px; border-radius: 9999px; background: var(--lily-surface-muted, #ece8df); color: var(--lily-text-muted-aa, #4e6b5a);
  }
  .meta { margin: 2px 0 0; font-size: 12px; color: var(--lily-text-muted-aa, #4e6b5a); }
  .badge { margin-top: 12px; }
  .compact .badge { margin-top: 0; }
  .cols { display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; margin: 14px 0 0; }
  dt { font-size: 10.5px; font-weight: 600; letter-spacing: 0.12em; color: var(--lily-text-muted-strong, #4f7060); }
  dd { margin: 3px 0 0; font-size: 13px; line-height: 1.35; }
  dd.sub, .sub { font-size: 11.5px; color: var(--lily-text-muted-aa, #4e6b5a); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 14px 0 0; }
  .chips li { padding: 4px 10px; border-radius: 9999px; background: var(--lily-surface-muted, #ece8df); font-size: 11.5px; }
  .privacy, .tag { margin: 12px 0 0; font-size: 11.5px; color: var(--lily-text-muted-aa, #4e6b5a); }
  .tag { font-style: italic; font-size: 10.5px; }
  .hours { margin-top: 14px; }
  .hours-row { display: flex; justify-content: space-between; font-size: 12.5px; }
  .bar { height: 8px; margin: 6px 0; background: var(--lily-surface-muted, #ece8df); border-radius: 9999px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--lily-primary, #1b6b3e); border-radius: 9999px; }
  .hours .sub { margin: 4px 0 0; }
</style>
