---
/**
 * Supervisor match inbox screen content (meant to sit inside a PhoneFrame).
 * Accept / Pass are static pills, not controls.
 */
interface Req { name: string; track: string; line: string }
interface Props { requests?: Req[] }
const {
  requests = [
    { name: 'Marcus Reed', track: 'LCSW track', line: 'Thu evenings · individual' },
    { name: 'Priya Natarajan', track: 'LPC track', line: 'Group of four · virtual' },
    { name: 'Jordan Ellis', track: 'LCSW track', line: 'Mon 6:00pm · individual' },
  ],
} = Astro.props;
---

<section class="inbox" data-mock="InboxPreview" data-illustrative aria-label="Example match inbox">
  <p class="eyebrow">MATCH INBOX <span class="example">Example</span></p>
  <h4>3 requests</h4>
  <ul>
    {requests.map((r) => (
      <li>
        <div class="who">
          <span class="avatar" aria-hidden="true">{r.name.split(' ').map((p) => p[0]).join('')}</span>
          <div><strong>{r.name}</strong><span>{r.track}</span><span>{r.line}</span></div>
        </div>
        <div class="acts"><span class="pill accept">Accept</span><span class="pill pass">Pass</span></div>
      </li>
    ))}
  </ul>
  <p class="note">A pass is quiet. They just see their next match.</p>
  <p class="tag" data-illustrative>Illustrative · pending validation</p>
</section>

<style>
  .inbox { box-sizing: border-box; padding: 8px 12px; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); color: var(--lily-text, #14522e); }
  p, h4 { margin: 0; }
  .eyebrow { font-size: 9.5px; font-weight: 600; letter-spacing: 0.12em; color: var(--lily-text-muted-strong, #4f7060); }
  .example { margin-left: 4px; font-size: 8.5px; padding: 1px 6px; border-radius: 9999px; background: var(--lily-surface-muted, #ece8df); letter-spacing: 0.06em; }
  h4 { font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-weight: 500; font-size: 22px; margin: 4px 0 10px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  li { padding: 10px; background: var(--lily-surface, #f8f5ef); border-radius: var(--radius-card-sm, 0.875rem); box-shadow: var(--shadow-subtle, 0 3px 5px rgb(20 82 46 / 7%)); }
  .who { display: flex; gap: 8px; align-items: center; }
  .who div { display: grid; font-size: 11px; line-height: 1.3; }
  .who strong { font-size: 13px; }
  .who span { color: var(--lily-text-muted-aa, #4e6b5a); }
  .avatar { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: rgb(20 82 46 / 10%); color: var(--lily-text, #14522e); font-size: 11px; font-weight: 600; flex: none; }
  .acts { display: flex; gap: 6px; margin-top: 8px; }
  .pill { padding: 4px 14px; border-radius: 9999px; font-size: 11px; font-weight: 600; }
  .accept { background: var(--lily-forest, #14522e); color: var(--lily-canvas, #f5f1e9); }
  .pass { background: var(--lily-surface-muted, #ece8df); color: var(--lily-text-muted-aa, #4e6b5a); }
  .note { margin-top: 10px; font-size: 10.5px; color: var(--lily-text-muted-aa, #4e6b5a); }
  .tag { margin-top: 4px; font-size: 9.5px; font-style: italic; color: var(--lily-text-muted-aa, #4e6b5a); }
</style>
