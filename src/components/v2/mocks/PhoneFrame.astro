---
/**
 * Static 250x510 phone bezel. Zero JS. The slot is the screen content.
 * Static imagery of the app: exposed to assistive tech as a single labelled image.
 */
interface Props {
  label?: string;
  class?: string;
}
const { label = 'Example screen from the Lily app', class: className } = Astro.props;
---

<div
  class:list={['phone', className]}
  data-mock="PhoneFrame"
  role="img"
  aria-label={label}
  style="width:250px;height:510px"
>
  <span class="notch" aria-hidden="true"></span>
  <div class="screen"><slot /></div>
  <span class="home" aria-hidden="true"></span>
</div>

<style>
  .phone {
    position: relative;
    box-sizing: border-box;
    flex: none;
    padding: 8px;
    background: var(--lily-forest, #14522e);
    border-radius: 38px;
    box-shadow: var(--shadow-card, 0 4px 8px rgb(20 82 46 / 8%)), 0 18px 32px rgb(20 82 46 / 18%);
  }
  .screen {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--lily-canvas, #f5f1e9);
    color: var(--lily-text, #14522e);
    border-radius: 31px;
    font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif);
    padding-top: 30px;
  }
  .notch {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 50%;
    width: 74px;
    height: 20px;
    transform: translateX(-50%);
    background: var(--lily-forest, #14522e);
    border-radius: 12px;
  }
  .home {
    position: absolute;
    z-index: 2;
    bottom: 14px;
    left: 50%;
    width: 84px;
    height: 4px;
    transform: translateX(-50%);
    background: var(--lily-forest, #14522e);
    border-radius: 4px;
    opacity: 0.85;
  }
</style>
