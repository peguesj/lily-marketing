---
/**
 * Validation boundary notice. Any supervisor eligibility / licensure / verification copy
 * must sit next to (or inside) one of these until validated.
 * Default detail is the TrustNotice copy from components-site.jsx.
 */
interface Props { class?: string }
const { class: extra } = Astro.props;
---
<aside class:list={['v2-illustrative', extra]} data-illustrative>
  <p class="v2-illustrative__label">Illustrative · pending validation</p>
  <div class="v2-illustrative__detail">
    <slot>
      <p>Prototype copy does not establish a credential, certification, verification outcome, clinical relationship, insurance status, fee-sharing arrangement, or guaranteed timeline.</p>
    </slot>
  </div>
</aside>

<style>
  .v2-illustrative {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    border: 1px dashed color-mix(in srgb, var(--lily-primary, #1B6B3E) 45%, transparent);
    border-radius: var(--radius-card-sm, 0.875rem);
    background: var(--lily-surface-muted, #ECE8DF);
    color: var(--lily-text-muted-aa, #4E6B5A);
    font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif);
  }
  .v2-illustrative__label {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lily-forest, #14522E);
  }
  .v2-illustrative__detail { font-size: 0.8125rem; line-height: 1.5; }
  .v2-illustrative__detail :global(p) { margin: 0; }
</style>
