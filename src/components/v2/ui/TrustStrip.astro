---
/** Inline list of short trust statements, each led by a check disc. */
interface Props {
  items: string[];
  onDark?: boolean;
  class?: string;
}
const { items, onDark = false, class: extra } = Astro.props;
---
<ul class:list={['v2-trust', onDark && 'v2-trust--on-dark', extra]}>
  {items.map((item) => (
    <li class="v2-trust__item">
      <span class="v2-trust__disc" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" focusable="false">
          <path d="M2.5 6.2 5 8.6l4.5-5.2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span>{item}</span>
    </li>
  ))}
</ul>

<style>
  .v2-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif);
    font-size: 0.875rem;
    color: var(--lily-text-muted-aa, #4E6B5A);
  }
  .v2-trust__item { display: inline-flex; align-items: center; gap: 0.5rem; }
  .v2-trust__disc {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--lily-primary, #1B6B3E);
    color: var(--lily-canvas, #F5F1E9);
    flex: none;
  }
  .v2-trust--on-dark { color: var(--lily-canvas, #F5F1E9); }
  .v2-trust--on-dark .v2-trust__disc { background: var(--lily-canvas, #F5F1E9); color: var(--lily-forest, #14522E); }
</style>
