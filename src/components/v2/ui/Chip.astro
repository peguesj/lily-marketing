---
/**
 * Pill chip. Semantic colours (status) appear only as a dot, never as a text/fill colour.
 */
interface Props {
  variant?: 'default' | 'selected' | 'teal' | 'peach' | 'muted' | 'status';
  /** Dot colour for the `status` variant. */
  status?: 'success' | 'warning' | 'danger' | 'neutral';
  class?: string;
}
const { variant = 'default', status = 'neutral', class: extra } = Astro.props;
---
<span class:list={['v2-chip', `v2-chip--${variant}`, extra]}>
  {variant === 'selected' && (
    <svg class="v2-chip__check" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
      <path d="M2.5 6.2 5 8.6l4.5-5.2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {variant === 'status' && <span class={`v2-chip__dot v2-chip__dot--${status}`} aria-hidden="true"></span>}
  <slot />
</span>

<style>
  .v2-chip {
    --_forest: var(--lily-forest, #14522E);
    --_primary: var(--lily-primary, #1B6B3E);
    --_teal: var(--lily-teal, #318171);
    --_peach: var(--lily-peach, #F0B882);
    --_canvas: var(--lily-canvas, #F5F1E9);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2rem;
    padding: 0.3125rem 0.875rem;
    border: 1px solid var(--lily-border, #D5DFD9);
    border-radius: var(--radius-chip, 9999px);
    background: var(--lily-surface, #F8F5EF);
    color: var(--_forest);
    font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }
  .v2-chip--selected { background: var(--_primary); border-color: var(--_primary); color: var(--_canvas); font-weight: 600; }
  .v2-chip--teal { background: color-mix(in srgb, var(--_teal) 14%, var(--_canvas)); border-color: color-mix(in srgb, var(--_teal) 30%, transparent); color: var(--_forest); }
  /* Peach is a tint only; text stays forest (never white on peach). */
  .v2-chip--peach { background: color-mix(in srgb, var(--_peach) 38%, var(--_canvas)); border-color: color-mix(in srgb, var(--_peach) 60%, transparent); color: var(--_forest); }
  .v2-chip--muted { background: var(--lily-surface-muted, #ECE8DF); border-color: transparent; color: var(--lily-text-muted-aa, #4E6B5A); }
  .v2-chip--status { background: var(--lily-surface, #F8F5EF); }

  .v2-chip__check { flex: none; }
  .v2-chip__dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; flex: none; background: var(--lily-text-muted-aa, #4E6B5A); }
  .v2-chip__dot--success { background: var(--lily-success, #28874F); }
  .v2-chip__dot--warning { background: var(--lily-warning, #F2A922); }
  .v2-chip__dot--danger { background: var(--lily-danger, #B83535); }
</style>
