---
import Section from '../../ui/Section.astro';
import Chip from '../../ui/Chip.astro';
---
<Section tone="canvas">
  <div class="partners">
    <h2 class="partners__eyebrow">Press &amp; partners</h2>
    <ul class="partners__chips" aria-label="Inquiry types">
      <li><Chip variant="teal">Incubator</Chip></li>
      <li><Chip variant="teal">Programs</Chip></li>
      <li><Chip variant="teal">Press</Chip></li>
    </ul>
    <p class="partners__line">
      For press, partnerships, or cohort sponsorship:
      <a href="mailto:hello@asklily.health">hello@asklily.health</a>
    </p>
  </div>
</Section>

<style>
  .partners { display: flex; flex-direction: column; gap: 1rem; }
  .partners__eyebrow { margin: 0; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lily-text-muted-aa, #4E6B5A); }
  .partners__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .partners__line { margin: 0; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 1.125rem; color: var(--lily-text-muted-aa, #4E6B5A); }
  .partners__line a { color: var(--lily-primary, #1B6B3E); font-weight: 600; text-underline-offset: 3px; }
</style>
