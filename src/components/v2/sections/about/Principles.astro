---
import Section from '../../ui/Section.astro';
import SectionHead from '../../ui/SectionHead.astro';
import IllustrativeNotice from '../../ui/IllustrativeNotice.astro';

const principles = [
  { title: 'Verify at the source', body: 'Licenses are checked against the licensing jurisdiction, not self-reported.' },
  { title: 'Show the rate first', body: 'Clear individual and group rates before a graduate reaches out.' },
  { title: 'Both sides sign', body: 'Agreements and weekly hours logs are confirmed together.' },
  { title: 'Keep notes out', body: 'Lily tracks hours and agreements, never clinical session notes.' },
];
---
<Section tone="surface" ariaLabelledby="principles-title">
  <SectionHead eyebrow="Our principles" title="Four rules we won’t bend." />
  <ol class="principles">
    {principles.map((p, i) => (
      <li class="principle">
        <span class="principle__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3>{p.title}</h3>
        <p>{p.body}</p>
      </li>
    ))}
  </ol>
  <IllustrativeNotice class="principles__notice">
    <p>These principles describe the intended pilot. How licenses are checked, and which jurisdictions and sources apply, is illustrative and pending validation.</p>
  </IllustrativeNotice>
</Section>

<style>
  .principles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; margin: 0 0 2rem; padding: 0; list-style: none; }
  .principle { padding: 1.75rem; border-radius: var(--radius-card, 1.25rem); background: var(--lily-canvas, #F5F1E9); box-shadow: var(--shadow-card, 0 4px 8px rgb(20 82 46 / 8%)); }
  .principle__num { display: block; margin-bottom: 0.75rem; font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-style: italic; font-size: 1.5rem; color: var(--lily-teal, #318171); }
  .principle h3 { margin: 0 0 0.5rem; font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-size: 1.25rem; color: var(--lily-forest, #14522E); }
  .principle p { margin: 0; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.9375rem; line-height: 1.55; color: var(--lily-text-muted-aa, #4E6B5A); }
  @media (max-width: 1000px) { .principles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .principles { grid-template-columns: minmax(0, 1fr); } }
</style>
