---
import Chip from '../../ui/Chip.astro';
/**
 * Platform-terms accordion on native details/summary (keyboard accessible, zero JS).
 * The first row is open; the rest start closed.
 */
interface Part { key: string; title: string; paragraphs: string[]; chip?: string }
interface Props { parts: Part[] }
const { parts } = Astro.props;
---
<div class="pterms">
  {parts.map((p, i) => (
    <details class="pterms__row" data-platform-term={p.key} open={i === 0}>
      <summary class="pterms__q">
        <span>{p.title}</span>
        <span class="pterms__glyph" aria-hidden="true"></span>
      </summary>
      <div class="pterms__a">
        {p.paragraphs.map((t) => <p>{t}</p>)}
        {p.chip && <div><Chip variant="peach">{p.chip}</Chip></div>}
      </div>
    </details>
  ))}
</div>

<style>
  .pterms { display: flex; flex-direction: column; gap: 0.75rem; max-width: 52rem; }
  .pterms__row { border: 1px solid var(--lily-border, #D5DFD9); border-radius: var(--radius-card-sm, 0.875rem); background: var(--lily-surface, #F8F5EF); }
  .pterms__row[open] { box-shadow: var(--shadow-subtle, 0 3px 5px rgb(20 82 46 / 7%)); }
  .pterms__q { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.125rem 1.25rem; border-radius: inherit; list-style: none; cursor: pointer; font-size: 1.0625rem; font-weight: 600; line-height: 1.4; color: var(--lily-forest, #14522E); }
  .pterms__q::-webkit-details-marker { display: none; }
  .pterms__q:focus-visible { outline: 2px solid var(--lily-forest, #14522E); outline-offset: 2px; }
  .pterms__glyph { position: relative; flex: none; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: color-mix(in srgb, var(--lily-teal, #318171) 14%, var(--lily-canvas, #F5F1E9)); }
  .pterms__glyph::before, .pterms__glyph::after { content: ''; position: absolute; top: 50%; left: 50%; background: var(--lily-primary, #1B6B3E); border-radius: 1px; transform: translate(-50%, -50%); transition: transform var(--motion-standard, 220ms) var(--motion-ease, ease); }
  .pterms__glyph::before { width: 0.625rem; height: 2px; }
  .pterms__glyph::after { width: 2px; height: 0.625rem; }
  .pterms__row[open] .pterms__glyph::after { transform: translate(-50%, -50%) scaleY(0); }
  .pterms__a { display: flex; flex-direction: column; gap: 0.75rem; padding: 0 1.25rem 1.25rem; font-size: 0.9375rem; line-height: 1.6; color: var(--lily-text-muted-aa, #4E6B5A); }
  .pterms__a :global(p) { margin: 0; }
  @media (prefers-reduced-motion: reduce) { .pterms__glyph::before, .pterms__glyph::after { transition: none; } }
</style>
