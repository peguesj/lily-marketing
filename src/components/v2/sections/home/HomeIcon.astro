---
/** Small stroke icons for the home tiles. Decorative (aria-hidden); the label always sits beside it. */
interface Props {
  name: 'users' | 'clock' | 'building' | 'calendar' | 'dollar' | 'shield';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'users' && (<>
    <circle cx="9" cy="8" r="3.2" /><path d="M3.5 19c.4-3.2 2.6-5 5.5-5s5.1 1.8 5.5 5" />
    <circle cx="17" cy="9" r="2.3" /><path d="M16 14.2c2.6-.2 4.2 1.3 4.5 4" />
  </>)}
  {name === 'clock' && (<><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>)}
  {name === 'building' && (<><rect x="5" y="3.5" width="14" height="17" rx="2" /><path d="M9 8h6M9 12h6M9 16h4" /></>)}
  {name === 'calendar' && (<><rect x="4" y="5.5" width="16" height="14.5" rx="2.2" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" /></>)}
  {name === 'dollar' && (<><path d="M12 3.5v17" /><path d="M16.5 8c-.6-1.6-2.3-2.4-4.5-2.4-2.5 0-4 1.2-4 3 0 4.4 9 2.2 9 6.6 0 1.9-1.8 3.2-4.5 3.2-2.4 0-4.3-.9-4.9-2.6" /></>)}
  {name === 'shield' && (<><path d="M12 3 5 5.8v5.4c0 4.4 2.9 8 7 9.8 4.1-1.8 7-5.4 7-9.8V5.8L12 3Z" /><path d="m8.8 12 2.3 2.3 4.2-4.4" /></>)}
</svg>
