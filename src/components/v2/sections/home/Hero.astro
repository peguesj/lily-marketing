---
import Container from '../../ui/Container.astro';
import Eyebrow from '../../ui/Eyebrow.astro';
import Button from '../../ui/Button.astro';
import TrustStrip from '../../ui/TrustStrip.astro';
import PetalMark from '../../ui/PetalMark.astro';
import Blob from '../../ui/Blob.astro';
import IllustrativeTag from './IllustrativeTag.astro';
import { appLinks } from '../../../../config/app';

const trust = ['Pennsylvania pilot', 'LPC and LCSW first', 'Licenses verified with the licensing jurisdiction'];
---
<section class="home-hero" data-home-section="hero" aria-labelledby="home-hero-title">
  <Blob color="teal" width="34rem" height="24rem" top="9rem" left="52%" opacity={0.2} />
  <Blob color="peach" width="30rem" height="20rem" top="1rem" right="-6rem" opacity={0.2} />
  <PetalMark class="home-hero__petal" petals={5} size={240} color="var(--lily-teal, #318171)" opacity={0.9} />
  <Container>
    <div class="home-hero__copy">
      <Eyebrow>Supervision, verified</Eyebrow>
      <h1 id="home-hero-title" class="home-hero__title">The two years nobody <em>told you about.</em></h1>
      <p class="home-hero__lead">Lily matches newly graduated clinicians with verified, fairly priced supervisors, writes the agreement, and keeps an hours log you both sign.</p>
      <div class="home-hero__actions">
        <Button variant="primary" href={appLinks.supervisorSignup} dataAction="home-hero-join-supervisor">Join as a supervisor</Button>
        <Button variant="outline" href={appLinks.graduateSignup} dataAction="home-hero-find-supervisor">Find a supervisor</Button>
      </div>
      <TrustStrip items={trust} />
      <IllustrativeTag />
    </div>
  </Container>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    padding-block: 7rem 3rem;
  }
  .home-hero :global(.home-hero__petal) {
    position: absolute;
    z-index: 0;
    top: 5rem;
    right: max(1.5rem, calc((100% - 1200px) / 2 + 3.5rem));
    overflow: visible;
  }
  .home-hero :global(.v2-container) { position: relative; z-index: 1; }
  .home-hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; max-width: 50rem; }
  .home-hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 5.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.08;
    color: var(--lily-forest, #14522E);
  }
  .home-hero__lead {
    margin: 0;
    max-width: 36rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--lily-text-muted-aa, #4E6B5A);
  }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 0.5rem; }
  @media (max-width: 768px) {
    .home-hero { padding-block: 4rem 2rem; }
    .home-hero :global(.home-hero__petal) { top: 0.25rem; right: 0.5rem; width: 96px; height: 96px; opacity: 0.3; }
    .home-hero__actions :global(.v2-btn) { flex: 1 1 100%; }
  }
</style>
