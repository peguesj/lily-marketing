---
import HomeSection from './HomeSection.astro';
import Eyebrow from '../../ui/Eyebrow.astro';
import TextLink from './TextLink.astro';
import IllustrativeTag from './IllustrativeTag.astro';

const pricing = [
  ['Graduates', 'pay the supervisor directly. No Lily fee at launch.'],
  ['Supervisors', 'pay nothing at launch, then a small per-session share.'],
  ['Programs', 'sponsor cohorts, priced per clinician per month.'],
] as const;
---
<HomeSection id="teasers">
  <div class="home-teasers">
    <article class="home-teaser" aria-labelledby="home-research-title">
      <Eyebrow>Research</Eyebrow>
      <h3 id="home-research-title" class="home-teaser__title">We asked the groups where graduates already <em>talk.</em></h3>
      <figure class="home-quote">
        <p class="home-quote__label">Community-research summary</p>
        <blockquote class="home-quote__text"><p>“I found out in my last semester.”</p></blockquote>
        <figcaption class="home-quote__by">Illustrative composite, not a verbatim post · MSW graduate, Philadelphia · Reddit r/socialwork, March 2026</figcaption>
      </figure>
      <IllustrativeTag />
      <TextLink class="home-teaser__link" href="/research" dataAction="home-teaser-research">Read the research</TextLink>
    </article>
    <article class="home-teaser" aria-labelledby="home-pricing-title">
      <Eyebrow>Pricing</Eyebrow>
      <h3 id="home-pricing-title" class="home-teaser__title">One price, shown <em>before you ask.</em></h3>
      <ul class="home-pricing">
        {pricing.map(([who, what]) => (
          <li class="home-pricing__row"><strong>{who}</strong> {what}</li>
        ))}
      </ul>
      <IllustrativeTag />
      <TextLink class="home-teaser__link" href="/pricing" dataAction="home-teaser-pricing">See pricing</TextLink>
    </article>
  </div>
</HomeSection>

<style>
  .home-teasers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .home-teaser {
    display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; padding: 2.5rem;
    border-radius: var(--radius-card, 1.25rem); background: var(--lily-surface, #F8F5EF);
    box-shadow: var(--shadow-card, 0 4px 8px rgb(20 82 46 / 8%));
  }
  .home-teaser__title { margin: 0; font-size: clamp(1.625rem, 2.6vw, 1.75rem); font-weight: 600; line-height: 1.2; color: var(--lily-forest, #14522E); }
  .home-teaser :global(.home-teaser__link) { margin-top: auto; }
  .home-quote { margin: 0; padding-left: 1rem; border-left: 3px solid var(--lily-primary, #1B6B3E); display: flex; flex-direction: column; gap: 0.375rem; }
  .home-quote__label { margin: 0; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lily-text-muted-aa, #4E6B5A); }
  .home-quote__text { margin: 0; }
  .home-quote__text p { margin: 0; font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-size: 1.25rem; font-style: italic; font-weight: 600; line-height: 1.3; color: var(--lily-forest, #14522E); }
  .home-quote__by { font-size: 0.875rem; color: var(--lily-text-muted-aa, #4E6B5A); }
  .home-pricing { display: flex; flex-direction: column; gap: 0.375rem; margin: 0; padding: 0; list-style: none; font-size: 0.9375rem; line-height: 1.5; color: var(--lily-text-muted-aa, #4E6B5A); }
  .home-pricing strong { color: var(--lily-forest, #14522E); font-weight: 600; }
  @media (max-width: 900px) { .home-teasers { grid-template-columns: 1fr; } .home-teaser { padding: 1.75rem 1.5rem; } }
</style>
