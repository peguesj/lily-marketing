---
import Container from '../../ui/Container.astro';
import Eyebrow from '../../ui/Eyebrow.astro';
import LilyVerifiedBadge from '../../mocks/LilyVerifiedBadge.astro';
import IllustrativeTag from './IllustrativeTag.astro';
/** "The rate is the first thing you see": copy beside one explicitly illustrative profile card. */
---
<section class="rate" aria-labelledby="rate-title">
  <Container>
    <div class="rate__grid">
      <div class="rate__copy">
        <Eyebrow>No rate request needed</Eyebrow>
        <h2 id="rate-title" class="rate__title">The rate is <em>the first thing you see.</em></h2>
        <p class="rate__lead">Compare individual and group supervision without another email asking about cost.</p>
        <div class="rate__context">
          <p class="rate__context-label">Pennsylvania rate context</p>
          <p>Rates vary by supervisor, format and pathway. The $95 / $45 pair is an example, not a median. Typical PA ranges are pending source validation.</p>
        </div>
      </div>
      <article class="rate__card" data-rate-example data-illustrative aria-label="Illustrative supervisor profile, not a live listing">
        <p class="rate__card-label">Illustrative profile · not a live listing</p>
        <dl class="rate__prices">
          <div><dt>Individual / hour</dt><dd>$95</dd></div>
          <div><dt>Group / hour / person</dt><dd>$45</dd></div>
        </dl>
        <div class="rate__who">
          <span class="rate__avatar" aria-hidden="true">RO</span>
          <div>
            <h3 class="rate__name">Renée Okafor, LCSW</h3>
            <p class="rate__meta">Philadelphia · Thu 7:00pm</p>
          </div>
        </div>
        <LilyVerifiedBadge />
        <p class="rate__approach">License-review approach pending jurisdiction-specific validation.</p>
        <p class="rate__fine">Example name, availability and verification state.</p>
        <IllustrativeTag />
      </article>
    </div>
  </Container>
</section>

<style>
  .rate { padding-block: 64px; }
  .rate__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4rem; align-items: start; }
  .rate__copy { display: flex; flex-direction: column; gap: 1rem; }
  .rate__title { margin: 0; font-size: clamp(1.875rem, 3.6vw, 2.5rem); font-weight: 600; line-height: 1.15; }
  .rate__lead { margin: 0; max-width: 28rem; font-size: 1.0625rem; line-height: 1.6; color: var(--lily-text-muted-aa, #4E6B5A); }
  .rate__context { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; max-width: 28rem; font-size: 0.9375rem; line-height: 1.6; color: var(--lily-text-muted-aa, #4E6B5A); }
  .rate__context p { margin: 0; }
  .rate__context-label { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  /* The shell's global [data-illustrative] chip rule (uppercase, centred) also hits this container, so undo it here. */
  .rate__card { display: flex; flex-direction: column; align-items: stretch; gap: 1.25rem; padding: 1.75rem; font-size: inherit; font-weight: inherit; letter-spacing: normal; text-transform: none; color: var(--lily-forest, #14522E); border: 1px solid var(--lily-border, #D5DFD9); border-radius: var(--radius-card, 1.25rem); background: var(--lily-surface, #F8F5EF); }
  .rate__card p, .rate__card h3 { margin: 0; }
  .rate__card-label { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lily-text-muted-aa, #4E6B5A); }
  .rate__prices { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin: 0; padding-bottom: 1.25rem; border-bottom: 1px solid var(--lily-border, #D5DFD9); }
  .rate__prices dt { order: 2; font-size: 0.9375rem; color: var(--lily-forest, #14522E); }
  .rate__prices div { display: flex; flex-direction: column; }
  .rate__prices dd { order: 1; margin: 0; font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-size: 2.5rem; font-weight: 600; line-height: 1.1; color: var(--lily-forest, #14522E); }
  .rate__card :global(span[data-mock='LilyVerifiedBadge']) { align-self: flex-start; padding: 0; border: 0; border-radius: 0; font-size: inherit; letter-spacing: normal; text-transform: none; }
  .rate__who { display: flex; align-items: center; gap: 1rem; }
  .rate__avatar { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--lily-surface-muted, #ECE8DF); font-size: 0.875rem; font-weight: 600; color: var(--lily-forest, #14522E); }
  .rate__name { font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 1.0625rem; font-weight: 600; letter-spacing: 0; }
  .rate__meta { font-size: 0.9375rem; color: var(--lily-text-muted-aa, #4E6B5A); }
  .rate__approach { font-size: 0.9375rem; color: var(--lily-forest, #14522E); }
  .rate__fine { font-size: 0.8125rem; color: var(--lily-text-muted-aa, #4E6B5A); }
  @media (max-width: 900px) { .rate__grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; } }
</style>
