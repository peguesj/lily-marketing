---
import StepCard from '../../ui/StepCard.astro';
import Chip from '../../ui/Chip.astro';
import IllustrativeTag from './IllustrativeTag.astro';
/** Step 6 visual: three roadmap cards. Nothing here is shipped; each card says so. */
const cards = [
  { n: '6.1', title: 'Credentialing', body: 'CAQH, NPI and payer panels as one checklist, with the date each payer answered.', meta: 'After licensure' },
  { n: '6.2', title: 'CE library', body: '30 hours per renewal cycle, logged against the same account as your supervision hours.', meta: '30 hrs / 2 yrs' },
  { n: '6.3', title: 'Referrals back in', body: "When you open to clients, Lily's client side matches them to you on the same six dimensions.", meta: 'Same 6 dimensions' },
];
---
<div class="grow">
  <ul class="grow__cards">
    {cards.map((c) => (
      <li>
        <StepCard number={c.n} title={c.title}>
          <p>{c.body}</p>
          <p class="grow__meta" data-roadmap><Chip variant="peach">Roadmap</Chip> <span>{c.meta}</span></p>
        </StepCard>
      </li>
    ))}
  </ul>
  <IllustrativeTag />
</div>

<style>
  .grow { display: flex; flex-direction: column; gap: 1rem; }
  .grow__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.875rem; margin: 0; padding: 0; list-style: none; }
  .grow__cards :global(.v2-step) { height: 100%; box-sizing: border-box; padding: 1.25rem 1rem; background: var(--lily-surface-muted, #ECE8DF); box-shadow: none; }
  .grow__cards :global(.v2-step__title) { font-size: 1.0625rem; }
  .grow__cards :global(.v2-step__body) { font-size: 0.8125rem; }
  .grow__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 0.75rem !important; font-family: var(--font-mono, monospace); font-size: 0.6875rem; }
  @media (max-width: 700px) { .grow__cards { grid-template-columns: minmax(0, 1fr); } }
</style>
