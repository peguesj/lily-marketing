---
import Section from '../../ui/Section.astro';
import ClaimHead from './ClaimHead.astro';
import FAQ from '../../ui/FAQ.astro';
import IllustrativeNotice from '../../ui/IllustrativeNotice.astro';

const items = [
  {
    q: 'What does Lily cost me?',
    a: 'Nothing at launch. You keep your full rate and the graduate pays you directly. When we add a per-session share, you get it in writing at least one billing cycle before it applies, and it never touches agreements already signed.',
  },
  {
    q: 'How do you verify?',
    a: 'You enter the number printed on your license. We look it up with proposed license-review source, confirm status and issue date, and re-check it every six months. Your profile is published only after it clears, usually within two business days.',
  },
  {
    q: 'What happens before the threshold?',
    a: 'Sign up once on your phone. We tell you when the Pennsylvania roster clears its threshold, then you sign off hours weekly. Nothing is published until it clears.',
  },
  {
    q: 'Can I run a group?',
    a: 'Set a per-seat rate. We fill the seats from your matches. A proposed recurring slot and reviewed license path; hours logged separately for each person. Most Pennsylvania boards count group hours toward the total, with a cap.',
  },
  {
    q: 'What if a graduate disputes hours?',
    a: 'Each week you confirm the hours from one notification. The log is dual-signed and exportable for the board when it is time. How a disputed week is resolved is pending validation.',
  },
  {
    q: 'Psychology Today vs Lily',
    a: 'Graduates find you on Psychology Today and message out of the blue. You do the screening alone. Lily books a real slot, like Thu 7:00pm, before you ever talk. We never auto-assign a supervisee to you.',
  },
];
---
<div data-section="faq" id="faq" class="sup-anchor">
  <Section tone="surface" ariaLabelledby="sup-faq-title">
    <ClaimHead id="sup-faq-title" eyebrow="Questions" title="Things supervisors" accent="ask" after=" us." />
    <FAQ items={items} openFirst />
    <IllustrativeNotice class="sup-faq__note">
      <p>Answers are drawn from the page above and describe proposed behavior. License review, the roster threshold, group-hour rules and any later fee are pending validation.</p>
    </IllustrativeNotice>
  </Section>
</div>

<style>
  .sup-anchor { scroll-margin-top: 80px; }
  :global(.sup-faq__note) { margin-top: 2rem; }
</style>
