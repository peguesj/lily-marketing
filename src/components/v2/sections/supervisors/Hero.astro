---
import Section from '../../ui/Section.astro';
import Blob from '../../ui/Blob.astro';
import PetalMark from '../../ui/PetalMark.astro';
import Eyebrow from '../../ui/Eyebrow.astro';
import Button from '../../ui/Button.astro';
import TrustStrip from '../../ui/TrustStrip.astro';
import { appLinks } from '../../../../config/app';
---
<div data-section="hero">
  <Section tone="canvas" ariaLabelledby="sup-hero-title" class="sup-hero">
    <Blob color="teal" top="-5rem" right="-6rem" />
    <Blob color="peach" width="18rem" height="12rem" bottom="-3rem" right="22%" />
    <PetalMark petals={3} size={240} color="var(--lily-teal, #318171)" opacity={0.9} class="sup-hero__petals" />
    <div class="sup-hero__copy">
      <Eyebrow>For supervisors · Pennsylvania pilot</Eyebrow>
      <h1 id="sup-hero-title" class="sup-hero__title">Supervise the next <em>generation</em>.</h1>
      <p class="sup-hero__lead">Paid, scheduled supervisees who already fit your license path. We verify, you choose.</p>
      <div class="sup-hero__actions">
        <Button href={appLinks.supervisorSignup} dataAction="supervisors-hero-join">Join as a supervisor</Button>
        <Button variant="outline" href="#verification" dataAction="supervisors-hero-how">See how verification works</Button>
      </div>
      <TrustStrip items={['No fee at launch', 'License review pending validation', 'LPC and LCSW matched first']} />
    </div>
  </Section>
</div>

<style>
  :global(.sup-hero) { overflow: hidden; padding-block: 128px 96px; }
  .sup-hero__copy { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; max-width: 40rem; }
  .sup-hero__title {
    margin: 0;
    font-family: var(--font-display, 'Playfair Display', Georgia, serif);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--lily-forest, #14522E);
  }
  .sup-hero__title em { font-style: italic; color: var(--lily-primary, #1B6B3E); }
  .sup-hero__lead { margin: 0; max-width: 34rem; font-size: 1.125rem; line-height: 1.55; color: var(--lily-text-muted-aa, #4E6B5A); }
  .sup-hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  :global(.sup-hero .sup-hero__petals) { position: absolute; z-index: 0; top: 4rem; right: max(1.5rem, calc(50% - 600px)); }
  @media (max-width: 800px) {
    :global(.sup-hero) { padding-block: 80px 64px; }
    :global(.sup-hero .sup-hero__petals) { opacity: 0.35; right: -2rem; top: 1rem; }
  }
</style>
