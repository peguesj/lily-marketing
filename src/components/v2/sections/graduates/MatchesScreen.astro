---
/** Graduate match results screen content (sits inside a PhoneFrame). Fictional supervisors. */
const matches = [
  { initials: 'MO', name: 'Maya Okafor, LCSW', rate: '$75/hr group', when: 'Thu 7:00pm · Online →' },
  { initials: 'AC', name: 'Alex Chen, LCSW', rate: '$80/hr group', when: 'Sat 10am' },
];
---
<section class="scr" aria-label="Example match results screen">
  <p class="eyebrow">Group · under $90/hr <span class="ex">Example</span></p>
  <ul class="cards">
    {matches.map((m) => (
      <li>
        <div class="who">
          <span class="avatar" aria-hidden="true">{m.initials}</span>
          <div><strong>{m.name}</strong><span class="rev">✓ License review pending · Example</span></div>
        </div>
        <p class="rate"><strong>{m.rate}</strong></p>
        <p class="when">{m.when}</p>
      </li>
    ))}
  </ul>
  <p class="note">Maya Okafor and Alex Chen are fictional.</p>
  <p class="tag">Illustrative · pending validation</p>
  <nav class="tabs" aria-hidden="true"><span class="on">Matches</span><span>Hours</span><span>Profile</span></nav>
</section>

<style>
  .scr { position: relative; box-sizing: border-box; height: 100%; padding: 12px 14px; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); color: var(--lily-text, #14522e); }
  p, ul { margin: 0; }
  .eyebrow { font-size: 9.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lily-text-muted-strong, #4f7060); }
  .ex { margin-left: 4px; font-size: 8.5px; padding: 1px 6px; border-radius: 9999px; background: var(--lily-surface-muted, #ece8df); letter-spacing: 0.06em; text-transform: none; }
  .cards { list-style: none; padding: 0; margin-top: 12px; display: grid; gap: 10px; }
  .cards li { padding: 12px; border-radius: var(--radius-card-sm, 0.875rem); background: var(--lily-surface, #f8f5ef); box-shadow: var(--shadow-subtle, 0 3px 5px rgb(20 82 46 / 7%)); }
  .who { display: flex; gap: 8px; align-items: center; }
  .who div { display: grid; line-height: 1.3; }
  .who strong { font-size: 13px; }
  .rev { font-size: 9.5px; color: var(--lily-text-muted-aa, #4e6b5a); }
  .avatar { display: grid; place-items: center; width: 32px; height: 32px; flex: none; border-radius: 50%; background: rgb(20 82 46 / 10%); font-size: 11px; font-weight: 600; }
  .rate { margin-top: 10px; font-size: 13px; }
  .rate strong { font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-size: 18px; font-weight: 500; }
  .when { margin-top: 2px; font-size: 11px; color: var(--lily-text-muted-aa, #4e6b5a); }
  .note, .tag { margin-top: 10px; font-size: 10px; font-style: italic; color: var(--lily-text-muted-aa, #4e6b5a); }
  .tabs { position: absolute; left: 0; right: 0; bottom: 18px; display: flex; justify-content: space-around; padding: 8px 0; border-top: 1px solid var(--lily-border, #d5dfd9); font-size: 10.5px; color: var(--lily-text-muted-aa, #4e6b5a); }
  .tabs .on { font-weight: 700; color: var(--lily-primary, #1b6b3e); }
</style>
