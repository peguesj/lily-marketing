---
import Section from '../../ui/Section.astro';
import SectionHead from '../../ui/SectionHead.astro';
import IllustrativeNotice from '../../ui/IllustrativeNotice.astro';

const phases = [
  { days: 'Days 1–7', title: 'Define your cohort', body: 'Tracks, budget and privacy roles.' },
  { days: 'Days 8–14', title: 'Review the roster', body: 'Invite clinicians and verify fit.' },
  { days: 'Days 15–21', title: 'Agree the matches', body: 'Confirm rates and sign terms.' },
  { days: 'Days 22–30', title: 'Begin and check in', body: 'Review your first weekly logs.' },
];
---
<Section tone="canvas" id="pilot" class="prog-pilot-section" ariaLabelledby="prog-pilot-title">
  <SectionHead
    eyebrow="Pilot and implementation"
    title="Pennsylvania pilot,"
    lead="A proposed 30-day onboarding plan, subject to local supervisor availability."
  >
    <Fragment slot="accent">LPC and LCSW first.</Fragment>
  </SectionHead>
  <ol class="prog-pilot">
    {phases.map((p) => (
      <li class="prog-pilot__step">
        <p class="prog-pilot__days">{p.days}</p>
        <h3>{p.title}</h3>
        <p>{p.body}</p>
      </li>
    ))}
  </ol>
  <div class="prog-pilot__notes">
    <p><strong>SSO optional.</strong> Scope your sign-in needs at kickoff; availability is confirmed in your proposal.</p>
    <p><strong>Data handling.</strong> Agree access, retention and export terms before upload. No client details or session notes.</p>
  </div>
  <IllustrativeNotice class="prog-pilot__notice">
    <p>The timeline is proposed and conditional on supervisor supply in your area. Nothing here is a confirmed schedule, partnership or compliance commitment.</p>
  </IllustrativeNotice>
</Section>

<style>
  :global(.prog-pilot-section) { scroll-margin-top: 4rem; }
  .prog-pilot { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1.25rem; counter-reset: step; }
  .prog-pilot__step { position: relative; padding: 1.5rem; border-radius: var(--radius-card, 1.25rem); background: var(--lily-surface, #F8F5EF); border: 1px solid var(--lily-border, #D5DFD9); border-top: 4px solid var(--lily-primary, #1B6B3E); }
  .prog-pilot__step h3 { margin: 0.25rem 0 0.375rem; font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-size: 1.25rem; font-weight: 500; color: var(--lily-forest, #14522E); }
  .prog-pilot__step p { margin: 0; font-size: 0.9375rem; line-height: 1.5; color: var(--lily-text-muted-aa, #4E6B5A); }
  .prog-pilot__step .prog-pilot__days { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lily-forest, #14522E); }
  .prog-pilot__notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.25rem; margin-top: 2rem; }
  .prog-pilot__notes p { margin: 0; padding: 1.25rem 1.5rem; border-radius: var(--radius-card-sm, 0.875rem); background: var(--lily-surface-muted, #ECE8DF); font-size: 0.9375rem; line-height: 1.5; color: var(--lily-forest, #14522E); }
  :global(.prog-pilot__notice) { margin-top: 1.5rem; max-width: 46rem; }
</style>
