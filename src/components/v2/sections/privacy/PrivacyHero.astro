---
import Container from '../../ui/Container.astro';
import Eyebrow from '../../ui/Eyebrow.astro';
import Chip from '../../ui/Chip.astro';
import Blob from '../../ui/Blob.astro';
import PetalMark from '../../ui/PetalMark.astro';
/** Privacy page hero: eyebrow, h1 with one italic phrase, plain-language lead, effective-date chip. */
---
<section class="phero">
  <Blob color="teal" top="-8rem" right="-10rem" opacity={0.14} />
  <Blob color="peach" width="20rem" height="14rem" bottom="-4rem" left="-6rem" opacity={0.16} />
  <Container class="phero__inner">
    <div class="phero__text">
      <Eyebrow>Privacy at Lily</Eyebrow>
      <h1 class="phero__title">Your data, in plain <em class="phero__accent">language</em>.</h1>
      <p class="phero__lead">We hold the information needed to make supervised practice work.</p>
      <p class="phero__lead">We do not collect your clinical records or therapy notes.</p>
      <div class="phero__meta">
        <Chip variant="teal"><span class="phero__mono">Effective 12 Oct 2026 · v1.0 (draft)</span></Chip>
      </div>
    </div>
    <div class="phero__art" aria-hidden="true">
      <PetalMark petals={4} size={240} />
    </div>
  </Container>
</section>

<style>
  .phero { position: relative; overflow: hidden; padding-block: 80px 64px; background: var(--lily-canvas, #F5F1E9); }
  .phero :global(.phero__inner) { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 3rem; }
  .phero__text { display: flex; flex-direction: column; gap: 1rem; max-width: 40rem; }
  .phero__title {
    margin: 0;
    font-family: var(--font-display, 'Playfair Display', Georgia, serif);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--lily-forest, #14522E);
  }
  .phero__accent { font-style: italic; font-weight: 500; color: var(--lily-primary, #1B6B3E); }
  .phero__lead { margin: 0; font-size: 1.1875rem; line-height: 1.55; color: var(--lily-text-muted-aa, #4E6B5A); }
  .phero__meta { margin-top: 0.5rem; }
  .phero__mono { font-family: var(--font-mono, 'Source Code Pro', Menlo, monospace); font-size: 0.75rem; letter-spacing: 0.04em; }
  .phero__art { display: grid; place-items: center; }
  @media (max-width: 800px) {
    .phero :global(.phero__inner) { grid-template-columns: 1fr; }
    .phero__art { display: none; }
  }
</style>
