---
/** Closed-by-default policy rows built on native details/summary (keyboard and screen-reader accessible, zero JS). */
interface Row { key: string; title: string; paragraphs: string[]; link?: { href: string; label: string } }
interface Props { rows: Row[] }
const { rows } = Astro.props;
---
<div class="policy">
  {rows.map((r) => (
    <details class="policy__row" data-policy-row={r.key}>
      <summary class="policy__q">
        <span>{r.title}</span>
        <span class="policy__glyph" aria-hidden="true"></span>
      </summary>
      <div class="policy__a">
        {r.paragraphs.map((p) => <p>{p}</p>)}
        {r.link && <p><a href={r.link.href}>{r.link.label}</a></p>}
      </div>
    </details>
  ))}
</div>

<style>
  .policy { display: flex; flex-direction: column; gap: 0.75rem; max-width: 48rem; }
  .policy__row { border: 1px solid var(--lily-border, #D5DFD9); border-radius: var(--radius-card-sm, 0.875rem); background: var(--lily-surface, #F8F5EF); }
  .policy__row[open] { box-shadow: var(--shadow-subtle, 0 3px 5px rgb(20 82 46 / 7%)); }
  .policy__q { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.125rem 1.25rem; border-radius: inherit; list-style: none; cursor: pointer; font-size: 1rem; font-weight: 600; line-height: 1.4; color: var(--lily-forest, #14522E); }
  .policy__q::-webkit-details-marker { display: none; }
  .policy__q:focus-visible { outline: 2px solid var(--lily-forest, #14522E); outline-offset: 2px; }
  .policy__glyph { position: relative; flex: none; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: color-mix(in srgb, var(--lily-teal, #318171) 14%, var(--lily-canvas, #F5F1E9)); }
  .policy__glyph::before, .policy__glyph::after { content: ''; position: absolute; top: 50%; left: 50%; background: var(--lily-primary, #1B6B3E); border-radius: 1px; transform: translate(-50%, -50%); transition: transform var(--motion-standard, 220ms) var(--motion-ease, ease); }
  .policy__glyph::before { width: 0.625rem; height: 2px; }
  .policy__glyph::after { width: 2px; height: 0.625rem; }
  .policy__row[open] .policy__glyph::after { transform: translate(-50%, -50%) scaleY(0); }
  .policy__a { display: flex; flex-direction: column; gap: 0.75rem; padding: 0 1.25rem 1.25rem; font-size: 0.9375rem; line-height: 1.6; color: var(--lily-text-muted-aa, #4E6B5A); }
  .policy__a :global(p) { margin: 0; }
  .policy__a :global(a) { color: var(--lily-primary, #1B6B3E); font-weight: 600; }
  @media (prefers-reduced-motion: reduce) { .policy__glyph::before, .policy__glyph::after { transition: none; } }
</style>
