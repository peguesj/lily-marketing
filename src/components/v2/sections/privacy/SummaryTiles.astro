---
import StatTile from '../../ui/StatTile.astro';
/** "The short version": four StatTiles for collection, purpose, access and retention. */
const tiles = [
  { key: 'collect', value: 'What we collect', caption: 'Account, credential, matching and supervised-hours information.' },
  { key: 'why', value: 'Why we use it', caption: 'To match, verify, document and notify you about your practice.' },
  { key: 'who', value: 'Who sees it', caption: 'You, your agreement partner and the parties you choose to involve.' },
  { key: 'keep', value: 'How long we keep it', caption: 'Hours logs remain available as licensure evidence after deletion.' },
] as const;
---
<div class="tiles" data-summary-tiles>
  {tiles.map((t) => (
    <StatTile class="tiles__tile" value={t.value} caption={t.caption}>
      <svg slot="icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {t.key === 'collect' && <path d="M4 5h12M4 10h12M4 15h7" />}
        {t.key === 'why' && <path d="M10 3c3 3.2 4.5 5.2 4.5 7.5a4.5 4.5 0 0 1-9 0C5.5 8.2 7 6.200 10 3Z" />}
        {t.key === 'who' && (<><circle cx="7.500" cy="7" r="2.500" /><path d="M3 16c.4-2.800 2-4 4.500-4s4.100 1.200 4.500 4M13 6.500a2.200 2.200 0 1 1 0 4.400M14 12.300c1.700.3 2.700 1.500 3 3.700" /></>)}
        {t.key === 'keep' && (<><circle cx="10" cy="10" r="6.500" /><path d="M10 6.500V10l2.500 1.500" /></>)}
      </svg>
    </StatTile>
  ))}
</div>

<style>
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  /* The tile value is a short heading here, not a big number. */
  .tiles :global(.tiles__tile .v2-stat__value) { font-size: 1.375rem; line-height: 1.2; }
  @media (max-width: 1000px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .tiles { grid-template-columns: 1fr; } }
</style>
