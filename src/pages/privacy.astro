---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/v2/ui/Section.astro';
import Button from '../components/v2/ui/Button.astro';
import CTABand from '../components/v2/ui/CTABand.astro';
import LegalBanner from '../components/v2/sections/terms/LegalBanner.astro';
import LegalHead from '../components/v2/sections/terms/LegalHead.astro';
import PrivacyHero from '../components/v2/sections/privacy/PrivacyHero.astro';
import SummaryTiles from '../components/v2/sections/privacy/SummaryTiles.astro';
import RoleCollectionCard from '../components/v2/sections/privacy/RoleCollectionCard.astro';
import PrivacyCallout from '../components/v2/sections/privacy/PrivacyCallout.astro';
import DisclosureList from '../components/v2/sections/privacy/DisclosureList.astro';
import ChoiceCard from '../components/v2/sections/privacy/ChoiceCard.astro';
import RetentionBand from '../components/v2/sections/privacy/RetentionBand.astro';
import PolicyRows from '../components/v2/sections/privacy/PolicyRows.astro';
import { appLinks } from '../config/app';

const PRIVACY_EMAIL = 'privacy@asklily.health';

const roles = [
  {
    role: 'graduate',
    label: 'Graduate',
    title: 'Your route to 3,000 supervised hours.',
    lines: ['Identity · licensure track · availability', 'Affinity answers · agreements · hours', 'attestations · direct messages'],
    notes: ['You control what is visible'],
  },
  {
    role: 'supervisor',
    label: 'Supervisor',
    title: 'A credible, clear supervision practice.',
    lines: ['Identity · active license · rates', 'Availability · practice details · hours', 'attestations · direct messages'],
    notes: ['Rates are always explicit'],
  },
  {
    role: 'program-admin',
    label: 'Program admin',
    title: 'A cohort with clear participation records.',
    lines: ['Sponsored cohort membership · hours', 'and signature status · aggregated reports'],
    notes: ['No affinity answers or messages', 'Clinical records never enter Lily'],
  },
] as const;

// None of these rows is in specs/site-privacy.md or the SVG: each renders an unsourced-draft label.
const policyRows: { key: string; title: string; paragraphs: string[]; link?: { href: string; label: string }; unsourced?: boolean }[] = [
  {
    key: 'children',
    unsourced: true,
    title: 'Children and age requirements',
    paragraphs: [
      'Lily is for adults. You must be 18 or older to create an account, and we do not knowingly collect personal information from anyone under 18.',
      `If you believe a child has given us information, email ${PRIVACY_EMAIL} and we will delete it.`,
    ],
  },
  {
    key: 'cookies',
    unsourced: true,
    title: 'Cookies and service analytics',
    paragraphs: [
      'We use the cookies needed to keep you signed in and remember your choices, and basic service analytics to see which pages and flows work. Analytics never include affinity answers, messages or hours logs.',
    ],
    link: { href: '/cookies', label: 'Read the cookie notice' },
  },
  {
    key: 'changes',
    unsourced: true,
    title: 'Changes to this privacy policy',
    paragraphs: [
      'When this policy changes we post the new version with its effective date and tell you in the app before any material change takes effect. Earlier versions are available on request.',
    ],
  },
];
---

<BaseLayout
  title="Privacy — Lily | Your data, in plain language"
  description="Lily's privacy policy for supervised practice: what we collect, why, who sees it, and how long we keep it. Draft for the Pennsylvania pilot, pending counsel review."
  canonical="https://www.asklily.health/privacy"
>
  <LegalBanner />
  <PrivacyHero />

  <Section tone="surface" ariaLabelledby="short-version">
    <LegalHead id="short-version" eyebrow="The short version" title="What privacy means,">
      <Fragment slot="accent">here</Fragment>
    </LegalHead>
    <SummaryTiles />
  </Section>

  <Section tone="canvas" ariaLabelledby="collect-title">
    <LegalHead id="collect-title" eyebrow="What we collect" title="Only what helps your practice" lead="Your role changes what you share. We keep the scope narrow.">
      <Fragment slot="accent">move</Fragment>
    </LegalHead>
    <div class="roles">
      {roles.map((r) => (
        <RoleCollectionCard role={r.role} label={r.label} title={r.title} lines={[...r.lines]} notes={[...r.notes]} />
      ))}
    </div>
    <div class="callout-gap"><PrivacyCallout /></div>
  </Section>

  <Section tone="surface" ariaLabelledby="share-title">
    <LegalHead id="share-title" eyebrow="How we use and share data" title="Useful with intent. Shared with">
      <Fragment slot="accent">care</Fragment>
    </LegalHead>
    <DisclosureList />
  </Section>

  <Section tone="canvas" ariaLabelledby="rights-title">
    <LegalHead id="rights-title" eyebrow="Your rights and choices" title="You stay" lead="Use your settings or write to us to take any of these actions.">
      <Fragment slot="accent">in control</Fragment>
    </LegalHead>
    <div class="choices">
      <ChoiceCard
        title="Export, correct or delete"
        body="Download your profile, agreements and hours log. Correct facts or request account deletion without losing sight of what remains."
        actionLabel="Request an export"
        actionHref={`mailto:${PRIVACY_EMAIL}?subject=${encodeURIComponent('Data export request')}`}
      />
      <ChoiceCard
        title="Control visibility and reminders"
        body="Choose cohort visibility, notification channels and what appears to potential matches before you agree to connect."
        actionLabel="Review privacy settings"
        actionHref={appLinks.signIn}
      />
    </div>
  </Section>

  <RetentionBand askHref={`mailto:${PRIVACY_EMAIL}?subject=${encodeURIComponent('Retention question')}`} />

  <Section tone="canvas" ariaLabelledby="policy-title">
    <LegalHead id="policy-title" eyebrow="The full policy" title="Questions deserve" lead="This policy covers children, cookies, policy changes and how to contact Lily.">
      <Fragment slot="accent">clear answers</Fragment>
    </LegalHead>
    <PolicyRows rows={policyRows} />
  </Section>

  <Section tone="canvas">
    <CTABand headline="Privacy should feel" lead={`Email ${PRIVACY_EMAIL} and we will help.`}>
      <Fragment slot="accent">human.</Fragment>
      <Button variant="inverse" href="/contact?topic=trust">Contact privacy</Button>
    </CTABand>
  </Section>
</BaseLayout>

<style>
  .roles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .callout-gap { margin-top: 3rem; }
  @media (max-width: 900px) {
    .roles, .choices { grid-template-columns: 1fr; }
  }
</style>
