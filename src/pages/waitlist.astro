---
import LegacyCopyNotice from '../components/LegacyCopyNotice.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Illustration from '../components/Illustration.tsx';
import WaitlistForm from '../components/v2/forms/WaitlistForm.tsx';
---

<BaseLayout
  title="Join the Waitlist — Lily | Be First to Experience Identity-Aware Care"
  description="Lily is launching soon. Join the waitlist to get early access to identity-aware therapy matching, AI-assisted wellness tools, and a platform built for all three sides."
  canonical="https://www.asklily.health/waitlist"
  keywords="Lily waitlist, early access therapy platform, mental health beta, identity-aware matching waitlist"
>
  <main>
    <LegacyCopyNotice />
    <section class="page-hero">
      <div class="container wide">
        <div class="page-hero-grid">
          <div>
            <div class="hero-eyebrow"><span class="dot"></span>Early access</div>
            <h1>Be first in line for <em>care that fits</em>.</h1>
            <p>
              Lily is launching soon. Drop your email and we'll let you know the moment your side of the platform is ready —
              whether you're seeking care, providing it, or paying for it.
            </p>

            <div style="margin-top: 2rem; max-width: 520px;">
              <WaitlistForm client:visible defaultAudience="supervisor" compact />
            </div>
          </div>
          <div class="page-hero-illust-wrap">
            <Illustration client:load n={3} size={300} alt="Growing together" />
          </div>
        </div>
      </div>
    </section>

    <section class="section cream">
      <div class="container narrow" style="text-align: center;">
        <div class="section-head center">
          <div class="section-eyebrow">What's coming</div>
          <h2 class="section-title">Three products. One platform.</h2>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2.5rem; margin-top: 2.5rem;">
          <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
            <div style="width: 72px; height: 72px; border-radius: 20px; background: hsla(145, 50%, 50%, 0.08); display: flex; align-items: center; justify-content: center;">
              <img src="/assets/icons/mental-health.svg" alt="" width="40" height="40" />
            </div>
            <h4 style="color: hsl(145, 60%, 26%); margin: 0;">Lily Care</h4>
            <p style="font-size: 0.95rem; margin: 0;">The member experience — identity-aware matching via Lily Match, wellness tools, mood tracking, and AI companion. Free for covered members.</p>
          </div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
            <div style="width: 72px; height: 72px; border-radius: 20px; background: hsla(155, 40%, 50%, 0.08); display: flex; align-items: center; justify-content: center;">
              <img src="/assets/icons/medical-record.svg" alt="" width="40" height="40" />
            </div>
            <h4 style="color: hsl(145, 60%, 26%); margin: 0;">Lily Practice</h4>
            <p style="font-size: 0.95rem; margin: 0;">All-in-one practice management for clinicians — telehealth, notes, billing, outcomes, and CE library.</p>
          </div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
            <div style="width: 72px; height: 72px; border-radius: 20px; background: hsla(30, 50%, 50%, 0.08); display: flex; align-items: center; justify-content: center;">
              <img src="/assets/icons/mission.svg" alt="" width="40" height="40" />
            </div>
            <h4 style="color: hsl(145, 60%, 26%); margin: 0;">Lily Admin</h4>
            <p style="font-size: 0.95rem; margin: 0;">Outcomes-tracked mental health benefit for organizations — network management, eligibility, de-identified reporting.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

