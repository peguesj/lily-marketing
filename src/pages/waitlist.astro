---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/v2/ui/Section.astro';
import CTABand from '../components/v2/ui/CTABand.astro';
import Button from '../components/v2/ui/Button.astro';
import WaitlistHero from '../components/v2/sections/waitlist/WaitlistHero.astro';
import FormSection from '../components/v2/sections/waitlist/FormSection.astro';
import NextSteps from '../components/v2/sections/waitlist/NextSteps.astro';
import PhoneSection from '../components/v2/sections/waitlist/PhoneSection.astro';
import { appLinks } from '../config/app';
---

<BaseLayout
  title="Join the Lily waitlist | Pennsylvania first"
  description="Join the Pennsylvania waitlist as a supervisor, graduate, or program. We open an area when its first local matches are ready. Counters shown are illustrative examples."
  canonical="https://www.asklily.health/waitlist"
  keywords="Lily waitlist, Pennsylvania clinical supervision, LPC supervision waitlist, LCSW supervision waitlist"
>
  <main>
    <WaitlistHero />
    <FormSection />
    <NextSteps />
    <PhoneSection />
    <Section tone="canvas">
      <CTABand headline="Ready when your area" lead="Join the list, or if you were already invited, start in the app.">
        <Fragment slot="accent">opens.</Fragment>
        <Button href="#join" variant="inverse">Join the waitlist</Button>
        <Button href={appLinks.welcome} variant="inverse" class="wl-ghost">Start in the app</Button>
      </CTABand>
    </Section>
  </main>
</BaseLayout>

<style>
  :global(.wl-ghost.v2-btn--inverse) { background: transparent; color: var(--lily-canvas, #F5F1E9); border-color: var(--lily-canvas, #F5F1E9); box-shadow: none; }
  :global(.wl-ghost.v2-btn--inverse:hover:not([disabled])) { background: color-mix(in srgb, var(--lily-canvas, #F5F1E9) 14%, transparent); }
</style>
