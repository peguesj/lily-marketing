---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/v2/forms/ContactForm.tsx';
import Illustration from '../components/Illustration.tsx';
---

<BaseLayout
  title="Contact — Lily | Talk to Our Team"
  description="Tell us who you are. We'll get you to a match, an application, or a demo — whichever fits."
  canonical="https://www.asklily.health/contact"
  keywords="contact Lily, demo request, therapist application, mental health platform support"
>
  <main>
    <!-- HERO -->
    <section class="page-hero">
      <div class="container wide">
        <div class="page-hero-grid">
          <div>
            <div class="hero-eyebrow"><span class="dot"></span>Get in touch</div>
            <h1>Let's get you to <em>the right thing</em>.</h1>
            <p>
              Tell us who you are. We'll get you to a match, an application, or a demo — whichever fits.
            </p>
          </div>
          <div class="page-hero-illust-wrap">
            <Illustration client:load n={8} size={280} alt="Connection, made easy" />
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT FORM — v2 island; posts to /api/submit (no simulated success) -->
    <section class="section">
      <div class="container wide">
        <ContactForm client:visible />
      </div>
    </section>
  </main>
</BaseLayout>
