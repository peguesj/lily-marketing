---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/v2/ui/Section.astro';
import CTABand from '../components/v2/ui/CTABand.astro';
import Button from '../components/v2/ui/Button.astro';
import AboutHero from '../components/v2/sections/about/AboutHero.astro';
import Narrative from '../components/v2/sections/about/Narrative.astro';
import Principles from '../components/v2/sections/about/Principles.astro';
import Team from '../components/v2/sections/about/Team.astro';
import Roadmap from '../components/v2/sections/about/Roadmap.astro';
import Partners from '../components/v2/sections/about/Partners.astro';
---

<BaseLayout
  title="About Lily | Why we narrowed to supervision matching"
  description="Lily started with client matching and narrowed on purpose to supervision for newly graduated mental-health clinicians. Meet the founders and the four principles behind the Pennsylvania pilot."
  canonical="https://www.asklily.health/about"
  keywords="about Lily, clinical supervision matching, LPC supervision, LCSW supervision, Pennsylvania pilot"
>
  <main>
    <AboutHero />
    <Narrative />
    <Principles />
    <Team />
    <Roadmap />
    <Partners />
    <Section tone="canvas">
      <CTABand
        headline="Help us build the"
        lead="Whether you supervise, are logging hours, or support new clinicians, your early interest shapes Lily."
      >
        <Fragment slot="accent">roster.</Fragment>
        <Button href="/waitlist" variant="inverse">Join the waitlist <span aria-hidden="true">→</span></Button>
      </CTABand>
    </Section>
  </main>
</BaseLayout>
