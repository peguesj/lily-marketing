---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/v2/ui/CTABand.astro';
import PetalMark from '../components/v2/ui/PetalMark.astro';
import Hero from '../components/v2/sections/home/Hero.astro';
import PathCards from '../components/v2/sections/home/PathCards.astro';
import GapNumbers from '../components/v2/sections/home/GapNumbers.astro';
import HowItWorks from '../components/v2/sections/home/HowItWorks.astro';
import TrustBand from '../components/v2/sections/home/TrustBand.astro';
import Affinity from '../components/v2/sections/home/Affinity.astro';
import SplitCards from '../components/v2/sections/home/SplitCards.astro';
import ProgramsBand from '../components/v2/sections/home/ProgramsBand.astro';
import AppBand from '../components/v2/sections/home/AppBand.astro';
import Teasers from '../components/v2/sections/home/Teasers.astro';
import IllustrativeTag from '../components/v2/sections/home/IllustrativeTag.astro';
import Button from '../components/v2/ui/Button.astro';
---

<BaseLayout
  title="Lily — Supervision, verified. Pennsylvania pilot"
  description="Lily matches newly graduated clinicians with verified, fairly priced supervisors, writes the agreement, and keeps an hours log you both sign. Pennsylvania pilot, LPC and LCSW first."
  canonical="https://www.asklily.health/"
  keywords="clinical supervision, LCSW supervision, LPC supervision, supervised hours, Pennsylvania, supervisor matching, supervision agreement"
>
  <Hero />
  <PathCards />
  <GapNumbers />
  <HowItWorks />
  <TrustBand />
  <Affinity />
  <SplitCards />
  <ProgramsBand />
  <AppBand />
  <Teasers />
  <div class="home-cta" data-home-section="cta">
    <PetalMark class="home-cta__petal" petals={3} size={170} color="var(--lily-canvas, #F5F1E9)" opacity={0.18} />
    <CTABand headline="Pennsylvania first. Your county" lead="Join the waitlist and we will tell you the week your county clears the threshold.">
      <Fragment slot="accent">next.</Fragment>
      <Button variant="inverse" href="/waitlist" dataAction="home-cta-waitlist">Join the waitlist</Button>
      <IllustrativeTag tone="dark" />
    </CTABand>
  </div>
</BaseLayout>

<style>
  .home-cta { position: relative; overflow: hidden; margin-top: 3rem; }
  .home-cta :global(.home-cta__petal) { position: absolute; z-index: 1; right: max(1.5rem, calc((100% - 1200px) / 2 + 1.5rem)); top: 50%; transform: translateY(-50%); }
  .home-cta :global(.v2-cta) { border-radius: 0; padding-block: 5rem; }
  .home-cta :global(.v2-cta__inner) { max-width: none; align-items: center; text-align: center; margin-inline: auto; }
  .home-cta :global(.v2-cta__lead) { max-width: 48rem; }
  .home-cta :global(.v2-cta__actions) { flex-direction: column; align-items: center; }
  @media (max-width: 700px) { .home-cta :global(.home-cta__petal) { display: none; } }
</style>
