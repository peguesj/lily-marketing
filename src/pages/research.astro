---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/v2/ui/Section.astro';
import SectionHead from '../components/v2/ui/SectionHead.astro';
import Eyebrow from '../components/v2/ui/Eyebrow.astro';
import IllustrativeNotice from '../components/v2/ui/IllustrativeNotice.astro';
import StepCard from '../components/v2/ui/StepCard.astro';
import Button from '../components/v2/ui/Button.astro';
import CTABand from '../components/v2/ui/CTABand.astro';
import ResearchStat from '../components/v2/sections/research/ResearchStat.astro';
import LicensureTable from '../components/v2/sections/research/LicensureTable.astro';
import QuoteCard from '../components/v2/sections/research/QuoteCard.astro';
import RankedBar from '../components/v2/sections/research/RankedBar.astro';
import RosterMeter from '../components/v2/sections/research/RosterMeter.astro';
import Lifecycle from '../components/v2/sections/research/Lifecycle.astro';

const stats = [
  { value: '~3,000', label: 'supervised hours', citation: 'Source: PA licensing boards, 2026 rules summary' },
  { value: '~2 years', label: 'minimum to finish', citation: 'Source: board rules; group median was 26 months' },
  { value: '~$150/hr', label: 'out-of-pocket rate', citation: 'Source: 23 PA supervisor listings, Aug 2026' },
  { value: '5+ years', label: 'licensed supervisor', citation: 'Source: board supervisor criteria, 2026' },
  { value: '$0', label: 'insurer payment before licensure; insurers do not reimburse it', citation: 'Source: payer policy review', inverted: true },
];

const licensure = [
  { code: 'LPC', name: 'Professional Counselor', experience: '~3,000 hrs, 2 years minimum', supervisor: 'Licensed 5+ years, qualifying field', board: 'Counselors, MFT and Social Work board' },
  { code: 'LCSW', name: 'Clinical Social Worker', experience: '~3,000 hrs, 2 years minimum', supervisor: 'LCSW licensed 5+ years', board: 'Counselors, MFT and Social Work board' },
  { code: 'LMFT', name: 'Marriage and Family Therapist', experience: '~3,000 hrs, 2 years minimum', supervisor: 'LMFT licensed 5+ years', board: 'Counselors, MFT and Social Work board' },
  { code: 'Psychology', name: 'Licensed psychologist', experience: '1 year postdoctoral (~1,800 hrs)', supervisor: 'Licensed psychologist', board: 'State Board of Psychology' },
];

const quotes = [
  { theme: 'Cost opacity', quote: 'I found out supervision was $150 an hour from a classmate, three months after I graduated.', who: 'MSW graduate, Philadelphia' },
  { theme: 'Vetting', quote: 'I had no way to tell if my supervisor was actually licensed long enough. I just trusted the flyer.', who: 'LPC associate, Pittsburgh' },
  { theme: 'Late discovery', quote: 'Nobody said a word about 3,000 hours until my last semester. By then I had loan payments due.', who: 'MA graduate, Lehigh Valley' },
  { theme: 'Employer leverage', quote: 'They said supervision was free if I stayed two years at their pay. I did not feel I could say no.', who: 'MSW associate, Harrisburg' },
];

const employer = [
  { title: 'Pay set below market', body: 'Groups described salaries tied to free in-house supervision, so the discount is hidden inside the offer.' },
  { title: 'Supervision as leverage', body: 'Leaving mid-contract can mean losing a supervisor and the signatures that count toward licensure.' },
  { title: 'Hours that do not travel', body: 'Hours logged on paper, signed late, or not at all. A move means starting the paperwork over.' },
];

const ranking = [
  { title: 'Rate transparency', detail: 'Know the price first', width: 92 },
  { title: 'Verification', detail: 'License checked', width: 76 },
  { title: 'Scheduling', detail: 'Evenings, Thu 7:00pm', width: 60 },
  { title: 'Affinity', detail: '8 identity dimensions', width: 46 },
];

const stages = [
  { title: 'Graduate', sub: 'MA, MSW or PsyD', pill: 'Join before you graduate' },
  { title: 'Find a supervisor', sub: 'search takes months', pill: 'Verified, priced match', stall: { title: 'Stall: no vetted supervisor', body: '$150/hr, rates hidden, license status hard to check' } },
  { title: 'Log ~3,000 hours', sub: 'about 2 years', pill: 'Agreement + dual-signed log', stall: { title: 'Stall: employer leverage', body: 'Hours signed late or not at all, no way to switch supervisors' } },
  { title: 'Exam, then license', sub: 'independent practice', pill: 'Hours export' },
];

const sources = [
  'PA State Board rules, 2026 summary',
  'PA State Board of Psychology',
  '23 supervisor rate listings, Aug 2026',
  'Payer policy review, 2026',
  'Lily community groups, Mar to Aug',
];
const methodology = [
  'Six moderated groups, 41 participants.',
  'Quotes are paraphrased and de-identified.',
  'Rates are asking prices, not paid prices.',
  'Rankings are group votes, not a survey.',
];
const limitations = [
  'State rules vary and change.',
  'Figures cover Pennsylvania only.',
  'Small sample, urban skew.',
  'Not legal or licensing advice. Check with your board.',
];
---

<BaseLayout
  title="The two-year gap, measured | Lily Research"
  description="Pennsylvania asks new clinicians for about 3,000 supervised hours before they can practice on their own. Illustrative research summary on what that costs and what graduates told us."
  canonical="https://www.asklily.health/research"
>
  <Section tone="canvas" as="div" class="rs-hero-wrap">
    <header class="hero">
      <Eyebrow>Research · Pennsylvania · 2026</Eyebrow>
      <h1 class="hero__title">The two-year gap, <em>measured</em>.</h1>
      <p class="hero__lead">Pennsylvania asks new clinicians for about 3,000 supervised hours before they can practice on their own. We measured what that costs and what graduates told us.</p>
      <div class="method" aria-labelledby="method-h">
        <p id="method-h" class="method__label">Method</p>
        <p class="method__body">Community-group study (6 groups, 41 graduates and associates, Mar to Aug 2026) · PA board requirements · supervision cost data from 23 listed supervisors · <time datetime="2026-10-11">Published Oct 11, 2026</time></p>
      </div>
      <IllustrativeNotice class="hero__notice">
        <p>This page is a draft. Every figure below is illustrative and pending validation.</p>
      </IllustrativeNotice>
    </header>
  </Section>

  <Section tone="surface" ariaLabelledby="findings-h">
    <h2 id="findings-h" class="visually-hidden">Key findings</h2>
    <IllustrativeNotice class="placeholder-notice">
      <p><strong>Study figures are placeholders, replace with real study data before publishing.</strong> This covers the 41 participants, 6 groups, 23 listings, the ranking bars and the 14 of 25 roster. PA rule rows must be confirmed against board sources.</p>
    </IllustrativeNotice>
    <p class="kicker" aria-hidden="true">Key findings</p>
    <div class="stats">
      {stats.map((s) => <ResearchStat {...s} />)}
    </div>
  </Section>

  <Section tone="canvas">
    <SectionHead eyebrow="Licensure by track" title="LPC, LCSW, LMFT, psychology: same gap," class="mb" >
      <Fragment slot="accent">different rules<span class="tail">.</span></Fragment>
    </SectionHead>
    <LicensureTable rows={licensure} />
    <p class="note">Rows are an illustrative summary for orientation, not legal advice. Confirm against PA board sources, and confirm every figure with the board before you rely on it. Board links open <a href="https://www.dos.pa.gov" target="_blank" rel="noopener noreferrer">dos.pa.gov<span class="visually-hidden"> (opens in a new tab)</span></a>.</p>
  </Section>

  <Section tone="surface">
    <SectionHead eyebrow="What graduates told us" title="“Nobody told us" class="mb">
      <Fragment slot="accent">before<span class="tail"> we graduated.”</span></Fragment>
    </SectionHead>
    <p class="note note--top">Quotes below are paraphrased, de-identified community-group posts and are illustrative.</p>
    <div class="quotes">
      {quotes.map((q) => <QuoteCard {...q} />)}
    </div>
  </Section>

  <Section tone="canvas">
    <SectionHead eyebrow="The employer dynamic" title="Two years of underpaid work in exchange for" class="mb">
      <Fragment slot="accent">supervision<span class="tail">.</span></Fragment>
    </SectionHead>
    <div class="steps">
      {employer.map((e, i) => (
        <StepCard number={i + 1} title={e.title}><p class="step-copy">{e.body}</p></StepCard>
      ))}
    </div>
  </Section>

  <Section tone="surface">
    <SectionHead eyebrow="What would help, ranked" title="Four things graduates asked for," class="mb">
      <Fragment slot="accent">in order<span class="tail">.</span></Fragment>
    </SectionHead>
    <ol class="ranked" aria-label="Help ranking, most requested first">
      {ranking.map((r, i) => <RankedBar rank={i + 1} {...r} />)}
    </ol>
    <p class="note">Bar length shows rank order only. Illustrative placeholder values.</p>
  </Section>

  <Section tone="canvas">
    <div class="supply">
      <div>
        <SectionHead eyebrow="Why supply first" title="Supervisors first," class="mb">
          <Fragment slot="accent">then the roster opens<span class="tail">.</span></Fragment>
        </SectionHead>
        <p class="supply__copy">A graduate who opens an empty app leaves and does not come back. So we recruit and verify supervisors first, county by county. When a local roster clears its threshold, everyone on the waitlist there gets one push: Lily is ready.</p>
        <ol class="supply__steps">
          <li>Supervisors join and are checked against a proposed license-review source.</li>
          <li>Roster crosses the threshold in the county.</li>
          <li>Waitlist gets one push: “Lily is ready.”</li>
        </ol>
      </div>
      <RosterMeter value={14} max={25} place="Philadelphia" />
    </div>
  </Section>

  <Section tone="surface">
    <SectionHead eyebrow="The licensure path" title="Where the path stalls, and" class="mb">
      <Fragment slot="accent">where Lily steps in<span class="tail">.</span></Fragment>
    </SectionHead>
    <Lifecycle stages={stages} />
  </Section>

  <Section tone="canvas" id="methodology">
    <SectionHead eyebrow="Sources, methodology and limitations" title="What we know, and" class="mb">
      <Fragment slot="accent">what we do not<span class="tail">.</span></Fragment>
    </SectionHead>
    <div class="trio">
      <section class="trio__col" aria-labelledby="src-h"><h3 id="src-h">Sources</h3><ul>{sources.map((s) => <li>{s}</li>)}</ul></section>
      <section class="trio__col" aria-labelledby="met-h"><h3 id="met-h">Methodology</h3><ul>{methodology.map((s) => <li>{s}</li>)}</ul></section>
      <section class="trio__col" aria-labelledby="lim-h"><h3 id="lim-h">Limitations</h3><ul>{limitations.map((s) => <li>{s}</li>)}</ul></section>
    </div>
    <div class="pdf">
      <Button variant="outline" disabled ariaLabel="Download the summary PDF (coming soon)">Download the summary PDF</Button>
      <p class="pdf__note">Coming soon. The summary will be published with the validated study data.</p>
    </div>
  </Section>

  <Section tone="canvas" as="div" class="cta-wrap">
    <CTABand headline="Help us close the gap in" lead="Join the waitlist and hear first when Lily is ready where you practice.">
      <Fragment slot="accent">your<span class="tail tail--cta"> county.</span></Fragment>
      <Button variant="inverse" href="/waitlist" dataAction="research-waitlist">Join the waitlist</Button>
    </CTABand>
  </Section>
</BaseLayout>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .hero { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; max-width: 52rem; }
  .hero__title { margin: 0; font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 600; line-height: 1.08; color: var(--lily-forest, #14522E); }
  .hero__title em { font-style: italic; font-weight: 500; color: var(--lily-primary, #1B6B3E); }
  .hero__lead { margin: 0; max-width: 42rem; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 1.125rem; line-height: 1.6; color: var(--lily-forest, #14522E); }
  .method { padding: 1.25rem 1.5rem; border-radius: var(--radius-card, 1.25rem); background: var(--lily-surface, #F8F5EF); box-shadow: var(--shadow-card, 0 4px 8px rgb(20 82 46 / 8%)); }
  .method p { margin: 0; }
  .method__label { font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lily-text-muted-aa, #4E6B5A); }
  .method__body { margin-top: 0.375rem; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.9375rem; line-height: 1.55; color: var(--lily-forest, #14522E); }
  .hero__notice { width: 100%; box-sizing: border-box; }
  .placeholder-notice { margin-bottom: 2rem; border-style: solid; border-width: 1.5px; border-color: var(--lily-warning, #F2A922); }
  .placeholder-notice :global(p) { font-size: 0.9375rem; }
  .kicker { margin: 0 0 1.5rem; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--lily-primary, #1B6B3E); }
  .stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.25rem; }
  .quotes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .step-copy { margin: 0; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.9375rem; line-height: 1.55; color: var(--lily-forest, #14522E); }
  .ranked { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin: 0; padding: 0; }
  .supply { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3rem; align-items: center; }
  .supply__copy { margin: 0 0 1.25rem; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 1rem; line-height: 1.65; color: var(--lily-forest, #14522E); }
  .supply__steps { margin: 0; padding-left: 1.25rem; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.9375rem; line-height: 1.6; color: var(--lily-forest, #14522E); }
  .trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .trio__col { padding: 1.5rem; border-radius: var(--radius-card, 1.25rem); background: var(--lily-surface, #F8F5EF); box-shadow: var(--shadow-subtle, 0 3px 5px rgb(20 82 46 / 7%)); }
  .trio__col h3 { margin: 0 0 0.75rem; font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-size: 1.25rem; color: var(--lily-forest, #14522E); }
  .trio__col ul { margin: 0; padding-left: 1.125rem; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.875rem; line-height: 1.6; color: var(--lily-forest, #14522E); }
  .pdf { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2rem; }
  .pdf__note { margin: 0; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.8125rem; color: var(--lily-text-muted-aa, #4E6B5A); }
  .note { margin: 1.25rem 0 0; max-width: 52rem; font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif); font-size: 0.8125rem; line-height: 1.55; color: var(--lily-text-muted-aa, #4E6B5A); }
  .note a { color: var(--lily-primary, #1B6B3E); }
  .note--top { margin: 0 0 1.5rem; }
  .tail { font-style: normal; font-weight: 600; color: var(--lily-forest, #14522E); }
  .tail--cta { color: var(--lily-canvas, #F5F1E9); }
  :global(.mb) { margin-bottom: 2rem; }
  @media (max-width: 1100px) { .stats { grid-template-columns: repeat(3, minmax(0, 1fr)); } .quotes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .steps, .trio, .ranked, .supply { grid-template-columns: 1fr; } .supply { gap: 2rem; } }
  @media (max-width: 560px) { .stats, .quotes { grid-template-columns: 1fr; } }
</style>
