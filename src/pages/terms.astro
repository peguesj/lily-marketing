---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/v2/ui/Section.astro';
import Button from '../components/v2/ui/Button.astro';
import Chip from '../components/v2/ui/Chip.astro';
import CTABand from '../components/v2/ui/CTABand.astro';
import StepCard from '../components/v2/ui/StepCard.astro';
import LegalBanner from '../components/v2/sections/terms/LegalBanner.astro';
import LegalHead from '../components/v2/sections/terms/LegalHead.astro';
import TermsHero from '../components/v2/sections/terms/TermsHero.astro';
import PlatformTerms from '../components/v2/sections/terms/PlatformTerms.astro';
import AgreementList from '../components/v2/sections/terms/AgreementList.astro';
import AttestationPanel from '../components/v2/sections/terms/AttestationPanel.astro';
import InfoCard from '../components/v2/sections/terms/InfoCard.astro';
import attestations from '../content/legal/attestations.json';
import agreement from '../content/legal/agreement-terms.json';
import platform from '../content/legal/platform-terms.json';
import { appLinks } from '../config/app';

const EFFECTIVE = '2026-11-03';
const VERSION = '1.0 (draft)';

const supervisorAttestation = attestations.agreement_supervisor_v1;
const superviseeAttestation = attestations.agreement_supervisee_v1;
const weeklyAttestation = attestations.weekly_signoff_v1;
---

<BaseLayout
  title="Terms — Lily | The terms, and what you sign"
  description="Lily's platform terms, the supervision agreement both sides countersign, and the exact weekly sign-off wording. Draft for the Pennsylvania pilot, pending counsel review."
  canonical="https://www.asklily.health/terms"
>
  <LegalBanner />
  <TermsHero effective={EFFECTIVE} version={VERSION} scope="PA pilot" />

  <Section tone="surface" ariaLabelledby="who-title">
    <LegalHead id="who-title" eyebrow="Who Lily is and is not" title="Lily is the" suffix=", not your supervisor.">
      <Fragment slot="accent">platform</Fragment>
    </LegalHead>
    <div class="who">
      <StepCard number={1} title="A platform">
        <p>Lily matches graduates with verified supervisors, produces the agreement, and keeps the weekly hours log. We are not a supervisor, employer, or licensing body.</p>
      </StepCard>
      <StepCard number={2} title="Supervisors are independent">
        <p>Every supervisor is an independent licensed professional. They set their own clinical methods and are solely responsible for the supervision they give.</p>
      </StepCard>
      <StepCard number={3} title="You own your licensure">
        <p>Graduates remain responsible for meeting every board requirement: approved supervisor, hours, forms, and deadlines. Lily records; the board decides.</p>
      </StepCard>
    </div>
  </Section>

  <Section tone="canvas" ariaLabelledby="rules-title">
    <LegalHead id="rules-title" eyebrow="Platform terms" title="The" suffix=", in five parts.">
      <Fragment slot="accent">rules</Fragment>
    </LegalHead>
    <PlatformTerms parts={platform.parts} />
  </Section>

  <Section tone="surface" id="agreement" ariaLabelledby="agreement-title">
    <LegalHead
      id="agreement-title"
      eyebrow="Supervision agreement template"
      title="The agreement you"
      lead="Both sides review these ten terms in the app before the first session. Example values below show a typical individual arrangement."
    >
      <Fragment slot="accent">countersign</Fragment>
    </LegalHead>
    <AgreementList terms={agreement.terms} />

    <div class="countersign">
      <h3 class="countersign__title">What each side attests when countersigning</h3>
      <div class="countersign__grid">
        <AttestationPanel tone="light" statementKey="agreement_supervisor_v1" label={`${supervisorAttestation.signer} attests`} text={supervisorAttestation.text} />
        <AttestationPanel tone="light" statementKey="agreement_supervisee_v1" label={`${superviseeAttestation.signer} attests`} text={superviseeAttestation.text} />
      </div>
    </div>
  </Section>

  <Section tone="canvas" id="attestation" ariaLabelledby="attestation-title">
    <LegalHead id="attestation-title" eyebrow="Attestation language" title="What a weekly sign-off">
      <Fragment slot="accent">says</Fragment>
    </LegalHead>
    <AttestationPanel
      statementKey="weekly_signoff_v1"
      label="Exact text, shown at every sign-off"
      text={weeklyAttestation.text}
      footer="Example entry: 1.5 hours · Running: 1,240 of 3,000 hours"
    />
    <div class="pair">
      <InfoCard title="If you disagree">
        <p>Either party can dispute an entry within 14 days. Both are notified, the entry is held, and you resolve it directly. Lily can mediate but does not decide.</p>
      </InfoCard>
      <InfoCard title="Lily does not certify hours">
        <p>Lily keeps the record. Only your licensing board accepts, audits, or rejects hours toward licensure.</p>
      </InfoCard>
    </div>
  </Section>

  <Section tone="surface" ariaLabelledby="state-title">
    <LegalHead id="state-title" eyebrow="State rules" title="Requirements differ by">
      <Fragment slot="accent">state and license</Fragment>
    </LegalHead>
    <InfoCard class="state" title="Pennsylvania pilot scope">
      <p>The pilot covers LPC and LCSW supervision under Pennsylvania rules. Other states and licenses (LMFT, psychology) differ in hours, supervisor eligibility, and format. Lily shows the rules for your state, but the board's current regulations always control. Check them before you begin.</p>
      <Chip variant="muted"><span class="mono">Pilot rules last reviewed 2026-10-01</span></Chip>
    </InfoCard>
  </Section>

  <Section tone="canvas" ariaLabelledby="print-title">
    <LegalHead id="print-title" eyebrow="Liability, law, and contact" title="The fine" suffix=", kept short.">
      <Fragment slot="accent">print</Fragment>
    </LegalHead>
    <div class="print">
      <InfoCard title="Liability">
        <p>Lily is not liable for the clinical supervision given, for licensure outcomes, or for indirect losses. Our total liability is limited to fees you paid Lily in the prior 12 months.</p>
      </InfoCard>
      <InfoCard title="Governing law">
        <p>These terms are governed by the laws of the Commonwealth of Pennsylvania. Disputes go to the state or federal courts in Philadelphia County.</p>
      </InfoCard>
      <InfoCard title="Changes">
        <p>We post changes here and notify you in the app. Material changes get 30 days notice, and you may close your account if you disagree.</p>
      </InfoCard>
      <InfoCard title="Contact">
        <p>Questions about these terms: <a href="mailto:legal@lily.example">legal@lily.example</a> (placeholder address). Lily, Philadelphia, Pennsylvania. We reply within two business days.</p>
      </InfoCard>
    </div>
  </Section>

  <Section tone="canvas">
    <CTABand headline="Ready when" lead="Join the waitlist and we will tell you the day your local roster is ready.">
      <Fragment slot="accent">you are.</Fragment>
      <div class="cta-actions">
        <Button variant="inverse" href={appLinks.supervisorSignup} dataAction="join-supervisor">Join as a supervisor</Button>
        <Button variant="outline" class="cta-ghost" href={appLinks.signIn} dataAction="see-my-matches">See my matches</Button>
      </div>
    </CTABand>
  </Section>
</BaseLayout>

<style>
  .who { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .countersign { margin-top: 3rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .countersign__title { margin: 0; font-family: var(--font-display, 'Playfair Display', Georgia, serif); font-size: 1.5rem; font-weight: 600; line-height: 1.25; color: var(--lily-forest, #14522E); }
  .countersign__grid, .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .pair { margin-top: 1.5rem; }
  .print { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .mono { font-family: var(--font-mono, 'Source Code Pro', Menlo, monospace); font-size: 0.75rem; letter-spacing: 0.04em; }
  /* Secondary pill on the forest gradient: cream outline instead of the green outline variant. */
  .cta-actions :global(.cta-ghost) { color: var(--lily-canvas, #F5F1E9); border-color: var(--lily-canvas, #F5F1E9); }
  .cta-actions :global(.cta-ghost:hover:not([disabled])) { background: color-mix(in srgb, var(--lily-canvas, #F5F1E9) 14%, transparent); }
  .cta-actions :global(.cta-ghost:focus-visible) { outline-color: var(--lily-canvas, #F5F1E9); }
  @media (max-width: 900px) {
    .who, .countersign__grid, .pair, .print { grid-template-columns: 1fr; }
  }
</style>
