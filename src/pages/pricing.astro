---
/**
 * /pricing: the proposed Pennsylvania pilot model, legible before contact.
 * Spec: tmp/lily-design-v2/specs/site-pricing.md. This is a design handoff, not published commercial
 * terms: the 12% supervisor share, all rates, funding figures and refund policy are illustrative pending
 * validation, and each carries its own label.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingHero from '../components/v2/sections/pricing/PricingHero.astro';
import PricingCards from '../components/v2/sections/pricing/PricingCards.astro';
import RateTransparency from '../components/v2/sections/pricing/RateTransparency.astro';
import IncludedList from '../components/v2/sections/pricing/IncludedList.astro';
import ComparisonTable from '../components/v2/sections/pricing/ComparisonTable.astro';
import FundingExamples from '../components/v2/sections/pricing/FundingExamples.astro';
import PricingFaq from '../components/v2/sections/pricing/PricingFaq.astro';
import PricingCta from '../components/v2/sections/pricing/PricingCta.astro';
---

<BaseLayout
  title="Pricing | Lily"
  description="One price, shown before you ask. Graduates pay the posted supervisor rate with no Lily fee at launch; supervisors join free; programs pay per clinician per month. Pennsylvania pilot, proposed terms."
  canonical="https://www.asklily.health/pricing"
>
  <PricingHero />
  <PricingCards />
  <RateTransparency />
  <IncludedList />
  <ComparisonTable />
  <FundingExamples />
  <PricingFaq />
  <PricingCta />
  <p class="pricing-pilot-note">Pilot design preview · Commercial and policy terms subject to review.</p>
</BaseLayout>

<style>
  .pricing-pilot-note {
    max-width: 1200px; margin: 2rem auto 0; padding: 0 1rem;
    font-size: 0.8125rem; line-height: 1.5; text-align: center; color: var(--lily-text-muted-aa, #4E6B5A);
  }
</style>
