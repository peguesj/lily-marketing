---
import '../styles/global.css';
import SiteNav from '../components/SiteNav';
import SiteFooter from '../components/SiteFooter';

interface Props {
  /** Page title. The suffix " | Lily" is added unless it already contains "Lily". */
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  keywords?: string;
}

const {
  title: pageTitle,
  description = 'Lily matches newly graduated clinicians with verified, fairly priced supervisors, writes the agreement, and keeps an hours log you both sign. Pennsylvania pilot.',
  canonical,
  ogImage: ogImageProp,
  jsonLd,
  noindex = false,
  keywords,
} = Astro.props;

const siteUrl = 'https://www.asklily.health';
const title = /lily/i.test(pageTitle) ? pageTitle : `${pageTitle} | Lily`;
const canonicalURL = canonical ?? `${siteUrl}${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`;
const ogImage = ogImageProp ?? `${siteUrl}/assets/lily-icon-fullcolor.png`;

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Lily",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/assets/lily-icon-fullcolor.png`,
      },
      "sameAs": [],
      "description": "Lily matches newly graduated clinicians with verified, fairly priced supervisors and keeps a signed hours log.",
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Lily",
      "publisher": { "@id": `${siteUrl}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": canonicalURL,
      "url": canonicalURL,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}/#website` },
    },
  ],
};

const finalJsonLd = jsonLd ? { ...defaultJsonLd, "@graph": [...defaultJsonLd["@graph"], ...Object.values(jsonLd)] } : defaultJsonLd;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F1E9" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Lily" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Lily" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="apple-touch-icon" href="/assets/lily-icon-fullcolor.png" />

    <!-- JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(finalJsonLd)} />

    <!-- Font preloads — self-hosted (Jost, Caveat, Source Code Pro come from @fontsource via CSS) -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/PlayfairDisplay-Variable.woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/SpaceGrotesk-Variable.woff2"
      crossorigin="anonymous"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/lily-icon-green.png" />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteNav client:load currentPath={Astro.url.pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
